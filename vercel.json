{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/auto-cycle",
      "schedule": "*/15 13-21 * * 1-5"
    },
    {
      "path": "/api/options-risk-cycle",
      "schedule": "*/15 13-21 * * 1-5"
    },
    {
      "path": "/api/crypto-risk-cycle",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/outcome-cycle",
      "schedule": "15 22 * * 1-5"
    },
    {
      "path": "/api/shadow-router-cycle",
      "schedule": "5 15,17,19 * * 1-5"
    },
    {
      "path": "/api/multi-asset-outcome-cycle",
      "schedule": "35 14-22 * * 1-5"
    },
    {
      "path": "/api/research-cycle",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/forward-grade-cycle",
      "schedule": "45 22 * * 1-5"
    }
  ]
}
